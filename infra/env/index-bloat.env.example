# OPCHUB — template for /etc/opchub/index-bloat.env (root:postgres 0640), opchub-index-bloat.service.
# Runs as the postgres OS user over the local socket (peer auth), directly on 5432, not PgBouncer.
PGDATABASE=opchub
BLOAT_MIN_MB=50
BLOAT_MAX_PCT=30
UNUSED_DAYS=30
# Webhook that receives JSON {"text": "..."}; empty → journald only
ALERT_WEBHOOK_URL=
