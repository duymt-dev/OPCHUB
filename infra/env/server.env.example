# OPCHUB — mẫu /etc/opchub/server.env (root:opchub 0640) cho api@, socket@, worker và migrate.
# KHÔNG ghi secret vào repo. Khoá khớp apps/server/.env.example + env.schema.ts.
# API_PORT / SOCKET_PORT do unit systemd đặt theo instance (410<i> / 420<i>) — không đặt ở đây.

NODE_ENV=production
LOG_LEVEL=info
# Origin Portal + Admin (L3: tên miền thật)
CORS_ORIGINS=https://opchub.community,https://admin.opchub.community
# Nginx đứng trước → tin X-Forwarded-For
TRUST_PROXY=true
# TD-018: handshake socket tối đa / phút / IP và / tài khoản (mặc định 30)
SOCKET_CONNECT_PER_MIN=30

# Qua PgBouncer (transaction pooling) — bắt buộc ?pgbouncer=true
DATABASE_URL=postgresql://opchub_app:CHANGE_ME@127.0.0.1:6432/opchub?pgbouncer=true
# Thẳng Postgres 5432 — chỉ `prisma migrate deploy` (deploy.sh) dùng
DIRECT_URL=postgresql://opchub_migrator:CHANGE_ME@127.0.0.1:5432/opchub
DB_POOL_MAX=10

# L3: thêm mật khẩu nếu đặt requirepass: redis://:<pw>@127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379
REDIS_DB=1

# ≥ 32 ký tự ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=opchub
REFRESH_COOKIE_SECURE=true
PORTAL_URL=https://opchub.community
ADMIN_URL=https://admin.opchub.community

# Production gửi mail thật
MAIL_PROVIDER=smtp
MAIL_FROM_NAME=OPC Hub
MAIL_FROM_EMAIL=no-reply@opchub.community
# NA-05: thư/ngày dành riêng cho OTP + đặt lại mật khẩu (mặc định 20)
MAIL_OTP_RESERVE=20
# BUG-036: HMAC link huỷ nhận thư chiến dịch — BẮT BUỘC, ≥ 32 ký tự ngẫu nhiên, không đổi sau go-live
UNSUBSCRIBE_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# D-05: Bot / Dịch vụ (GĐ3) tắt ở production
FEATURE_BOTS=false
FEATURE_SERVICES=false

# L3: đổi sang sepay khi có tài khoản thật
BANK_PROVIDER=fake
# ≥ 16 ký tự ngẫu nhiên
BANK_WEBHOOK_SECRET=
SEPAY_API_TOKEN=
BANK_ACCOUNT_NO=
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_FULL_NAME=
TAX_LOOKUP_PROVIDER=fake
SSO_PROVIDER=fake

# S3 (RustFS, ADR-0007). Endpoint công khai qua Nginx để presigned URL dùng được từ trình duyệt.
S3_ENDPOINT=https://s3.opchub.community
S3_REGION=us-east-1
S3_BUCKET=opchub
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=https://s3.opchub.community/opchub

# 32 byte base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENC_KEY=

# PHẢI để trống ở production (server từ chối khởi động nếu có giá trị)
OTP_FIXED_CODE=

# Tuỳ chọn (Q-B65-1): chưa tích hợp SDK — chỉ giữ chỗ cho tới khi có DSN
SENTRY_DSN=
