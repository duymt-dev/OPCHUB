# OPCHUB — mẫu /etc/opchub/backup.env (root:postgres 0640) cho opchub-backup.service. Không secret ở đây:
# credential offsite nằm trong RCLONE_CONFIG (root:postgres 0640), tạo bằng `rclone config` (L3).
PGDATABASE=opchub
BACKUP_DIR=/var/backups/opchub/pg
BACKUP_KEEP_LOCAL=14
# §14: giữ 30 ngày
BACKUP_KEEP_REMOTE_DAYS=30
# <remote>:<bucket/đường-dẫn> trong rclone.conf
BACKUP_REMOTE=offsite:opchub-backup
WAL_ARCHIVE_DIR=/var/lib/postgresql/wal-archive
RCLONE_CONFIG=/etc/opchub/rclone.conf
ALERT_WEBHOOK_URL=
