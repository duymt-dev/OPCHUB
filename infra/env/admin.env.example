# OPCHUB — mẫu /etc/opchub/admin.env (root:opchub 0640) cho opchub-admin.
# NEXT_PUBLIC_* nhúng vào bundle lúc build: deploy.sh chép file này thành apps/admin/.env.production.local
# trước `pnpm build`. Đổi giá trị → phải deploy lại. Không đặt secret ở đây.
NEXT_PUBLIC_API_URL=/v1
NEXT_PUBLIC_API_MOCKING=off
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=off
# D-05: Bot tắt ở production
NEXT_PUBLIC_FEATURE_BOTS=off
# Gốc Portal cho link chia sẻ (L3: tên miền thật)
NEXT_PUBLIC_PORTAL_URL=https://opchub.community
# Tuỳ chọn (Q-B65-1)
SENTRY_DSN=
