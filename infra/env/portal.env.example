# OPCHUB — mẫu /etc/opchub/portal.env (root:opchub 0640) cho opchub-portal@.
# NEXT_PUBLIC_* nhúng vào bundle lúc build: deploy.sh chép file này thành apps/portal/.env.production.local
# trước `pnpm build`. Đổi giá trị → phải deploy lại, restart không đủ. Không đặt secret ở đây.
NEXT_PUBLIC_API_URL=/v1
# Production luôn gọi API thật
NEXT_PUBLIC_API_MOCKING=off
# D-35: production tắt hộp tài khoản dùng thử
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=off
# Tuỳ chọn (Q-B65-1)
SENTRY_DSN=

# Optional socket origin; leave unset/empty to use the page origin.
# NEXT_PUBLIC_SOCKET_URL=
