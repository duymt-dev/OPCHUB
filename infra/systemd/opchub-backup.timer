# OPCHUB — chạy backup 02:30 giờ Việt Nam mỗi đêm (systemd ≥ 235 hiểu múi giờ trong OnCalendar).
[Unit]
Description=OPCHUB nightly backup at 02:30 Asia/Ho_Chi_Minh

[Timer]
OnCalendar=*-*-* 02:30:00 Asia/Ho_Chi_Minh
Persistent=true
RandomizedDelaySec=5min
Unit=opchub-backup.service

[Install]
WantedBy=timers.target
