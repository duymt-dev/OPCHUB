{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:int": {
      "cache": false
    }
  },
  "globalPassThroughEnv": ["DATABASE_URL", "TEST_DATABASE_URL", "REDIS_URL", "REDIS_DB", "NODE_ENV"]
}
