# packages/db — chép thành .env (gitignored). Không ghi secret vào file này.
# Runtime/API reference (server PrismaService reads this key); DB CLI uses DIRECT_URL.
DATABASE_URL=
DIRECT_URL=
TEST_DATABASE_URL=
SEED_SUPER_ADMIN_PASSWORD=

