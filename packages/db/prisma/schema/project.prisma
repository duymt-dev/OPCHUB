// Domain project — data-model §7, SRS §8 (D-18 sửa → duyệt lại, BR-08 hiển thị), Admin G5b.

enum ProjectStatus {
  draft
  pending_review
  published
  hidden
  needs_changes
  rejected

  @@map("project_status")
}

enum ProjectStage {
  idea
  /// D-89 (v4): "Đang phát triển"
  developing
  mvp
  growth
  launched

  @@map("project_stage")
}

enum ProjectVisibility {
  public
  private

  @@map("project_visibility")
}

/// D-89 (v4): "Đối tượng tham gia" của dự án
enum ProjectAudience {
  student
  personal
  organization
  business

  @@map("project_audience")
}

enum ProjectTone {
  blue
  rose
  green
  amber
  violet

  @@map("project_tone")
}

enum RepoProvider {
  github
  gitlab

  @@map("repo_provider")
}

enum CommentType {
  feedback
  question
  partnership

  @@map("comment_type")
}

enum RepoAccessStatus {
  pending
  granted
  denied

  @@map("repo_access_status")
}

model Project {
  id              String             @id @default(uuid(7))
  ownerId         String             @map("owner_id")
  name            String             @default("")
  /// Nháp có thể chưa chọn lĩnh vực
  categoryId      String?            @map("category_id")
  /// Nhóm "nhà" hiển thị trên thẻ (nhóm đầu tiên được chia sẻ / nhóm của chủ dự án)
  groupId         String?            @map("group_id")
  summary         String             @default("")
  /// HTML đã sanitize lúc ghi (RichEditor)
  descriptionHtml String             @default("") @map("description_html")
  stage           ProjectStage       @default(idea)
  /// D-89 (v4): Sinh viên / Cá nhân / Tổ chức / Doanh nghiệp
  audience        ProjectAudience    @default(personal)
  /// D-89 (v4): nhu cầu kết nối (`PROJECT_NEEDS`); "Tìm nhà đầu tư" tự thêm khi Gói Gọi vốn hiệu lực
  needs           String[]           @default([])
  /// D-89 (v4): lượt xem trang chi tiết (đếm khi người khác mở)
  viewCount       Int                @default(0) @map("view_count")
  status          ProjectStatus      @default(draft)
  visibility      ProjectVisibility  @default(public)
  tone            ProjectTone        @default(blue)
  reviewNote      String?            @map("review_note")
  /// BUG-016 (QT-09, NĐ 13): liên hệ công khai do chủ dự án chọn hiển thị, không lộ hồ sơ cá nhân
  contactEmail    String?            @map("contact_email") @db.Citext
  contactPhone    String?            @map("contact_phone")
  /// D-89 (v4): địa chỉ liên hệ công khai (tùy chọn, chủ dự án tự nhập)
  contactAddress  String?            @map("contact_address")
  /// D-89 (v4) chi tiết: [{ title, body }] "Vấn đề / Giải pháp / Thị trường"; rỗng thì ẩn (BUG-038)
  highlights      Json               @default("[]")
  /// D-89 (v4) "Hình ảnh sản phẩm" (URL ảnh); rỗng thì ẩn
  gallery         String[]           @default([])
  /// D-89 (v4) tab "Cập nhật": [{ at, title, body, tone }] mốc dự án công bố; rỗng thì chỉ mốc hệ thống
  milestones      Json               @default("[]")
  country         String             @default("Việt Nam")
  tags            String[]           @default([])
  website         String?
  coverUrl        String?            @map("cover_url")
  testUrl         String?            @map("test_url")
  repoProvider    RepoProvider?      @map("repo_provider")
  repoUrl         String?            @map("repo_url")
  repoVisibility  ProjectVisibility? @map("repo_visibility")
  deckUrl         String?            @map("deck_url")
  /// Q-G5b-4: dự án nổi bật tuần — một dự án đang hiển thị (UQ partial viết tay)
  featuredAt      DateTime?          @map("featured_at") @db.Timestamptz(6)
  followersCount  Int                @default(0) @map("followers_count")
  commentCount    Int                @default(0) @map("comment_count")
  publishedAt     DateTime?          @map("published_at") @db.Timestamptz(6)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner        User                 @relation(fields: [ownerId], references: [id])
  category     Category?            @relation(fields: [categoryId], references: [id])
  group        Group?               @relation(fields: [groupId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  shares       ProjectShare[]
  funding      ProjectFunding?
  follows      ProjectFollow[]
  comments     ProjectComment[]
  repoAsks     RepoAccessRequest[]
  interests    InvestorInterest[]
  revisions    ProjectRevision[]
  fundraisings ProjectFundraising[]

  /// Dự án của tôi
  @@index([ownerId, updatedAt(sort: Desc)])
  /// Khám phá/hàng duyệt: partial viết tay (`projects_explore`, `projects_review`, `projects_admin`)
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid(7))
  projectId String   @map("project_id")
  userId    String?  @map("user_id")
  name      String
  role      String   @default("")
  avatarUrl String?  @map("avatar_url")
  isOwner   Boolean  @default(false) @map("is_owner")
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sort])
  @@map("project_members")
}

/// BR-08: dự án riêng tư chỉ hiện cho thành viên các nhóm được chia sẻ
model ProjectShare {
  projectId String   @map("project_id")
  groupId   String   @map("group_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([projectId, groupId])
  @@index([groupId])
  @@map("project_shares")
}

/// Gọi vốn (1–0..1). Tiền số nguyên theo `currency` (luật 10)
model ProjectFunding {
  projectId  String    @id @map("project_id")
  amount     BigInt
  currency   String    @default("VND")
  equityPct  Decimal   @default(0) @map("equity_pct") @db.Decimal(5, 2)
  round      String    @default("")
  instrument String    @default("")
  endsAt     DateTime? @map("ends_at") @db.Timestamptz(6)
  minTicket  BigInt    @default(0) @map("min_ticket")
  /// Đã huy động ngoài nền tảng (seed); "đã cam kết" = raised + tổng quan tâm
  raised     BigInt    @default(0)
  useOfFunds String    @default("") @map("use_of_funds")
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_fundings")
}

model ProjectFollow {
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_follows")
}

/// Góp ý (parent_id NULL) + trả lời (parent_id = góp ý gốc)
model ProjectComment {
  id         String      @id @default(uuid(7))
  projectId  String      @map("project_id")
  authorId   String      @map("author_id")
  parentId   String?     @map("parent_id")
  type       CommentType @default(feedback)
  body       String
  likeCount  Int         @default(0) @map("like_count")
  resolvedAt DateTime?   @map("resolved_at") @db.Timestamptz(6)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  project Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  ProjectComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ProjectComment[]     @relation("CommentReplies")
  likes   ProjectCommentLike[]

  @@index([projectId, parentId, createdAt])
  @@map("project_comments")
}

model ProjectCommentLike {
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  comment ProjectComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@map("project_comment_likes")
}

model RepoAccessRequest {
  projectId String           @map("project_id")
  userId    String           @map("user_id")
  status    RepoAccessStatus @default(pending)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("repo_access_requests")
}

enum ProjectRevisionStatus {
  draft
  pending_review
  needs_changes
  rejected
  approved

  @@map("project_revision_status")
}

/**
 * REQ-106: chủ dự án sửa dự án đã xuất bản → bản sửa chờ duyệt, bản đang hiển thị giữ nguyên.
 * `data` = `ProjectSave` đã chuẩn hoá (ảnh đã resolve, mô tả đã sanitize). Mỗi dự án tối đa một
 * bản sửa mở: UQ partial `project_revisions_open` viết tay (status draft/pending_review/needs_changes).
 */
model ProjectRevision {
  id         String                @id @default(uuid(7))
  projectId  String                @map("project_id")
  data       Json
  status     ProjectRevisionStatus @default(draft)
  reviewNote String?               @map("review_note")
  createdBy  String?               @map("created_by")
  decidedAt  DateTime?             @map("decided_at") @db.Timestamptz(6)
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Hàng chờ duyệt Admin (status = pending_review) và mốc "Cập nhật được duyệt" (approved, decided_at)
  @@index([status, updatedAt(sort: Desc)])
  @@index([projectId, status, decidedAt(sort: Desc)])
  @@map("project_revisions")
}

/// V4-610 (UP-11, D-82): Gói Gọi vốn theo dự án — chuyển trạng thái chỉ qua `fundraising-status.ts`
enum FundraisingStatus {
  pending_payment
  pending_review
  active
  expired
  rejected

  @@map("fundraising_status")
}

/**
 * Một lần mua Gói Gọi vốn (6 tháng). Gia hạn = bản ghi mới. Mã CK `GV` + 6 số (sequence
 * `fundraising_code_seq`); bản `legacy` = dự án đã khai báo gọi vốn trước V4 (không mã, amount 0).
 * UQ partial `project_fundraisings_open` (một khoản pending_* / dự án) viết tay.
 */
model ProjectFundraising {
  id                   String            @id @default(uuid(7))
  projectId            String            @map("project_id")
  ownerId              String            @map("owner_id")
  code                 String?           @unique
  /// Tiền VND tại thời điểm mua (`FUNDRAISING_PLAN.amount`)
  amount               Int
  status               FundraisingStatus @default(pending_payment)
  legacy               Boolean           @default(false)
  paymentTransactionId String?           @unique @map("payment_transaction_id")
  paidAt               DateTime?         @map("paid_at") @db.Timestamptz(6)
  reviewedBy           String?           @map("reviewed_by")
  reviewedAt           DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  reviewNote           String?           @map("review_note")
  startsAt             DateTime?         @map("starts_at") @db.Timestamptz(6)
  endsAt               DateTime?         @map("ends_at") @db.Timestamptz(6)
  /// Đã nhắc gia hạn T-14 (D-82)
  remindedAt           DateTime?         @map("reminded_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner      User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  commission Commission?
  payment    PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  /// Chi tiết / Admin: khoản theo dự án
  @@index([projectId, status])
  /// Job hết hạn + nhắc
  @@index([status, endsAt])
  /// Popup chọn dự án: khoản của tôi
  @@index([ownerId, createdAt(sort: Desc)])
  @@map("project_fundraisings")
}
