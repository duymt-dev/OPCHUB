// Domain investor — data-model §8, BR-09, D-14, Admin "Nhà đầu tư" (Q-G5c-1 → 3).
// D-72 (V4-604): danh sách + xuất — không trạng thái kết nối, không luồng trao đổi.

enum InvestorKind {
  individual
  business
  fund

  @@map("investor_kind")
}

/// BR-09: mỗi người một quan tâm cho mỗi dự án (UQ project_id, user_id)
model InvestorInterest {
  id           String       @id @default(uuid(7))
  projectId    String       @map("project_id")
  userId       String       @map("user_id")
  kind         InvestorKind
  contactName  String       @map("contact_name")
  phone        String
  organization String       @default("")
  /// Số nguyên theo `currency` (luật 10)
  amount       BigInt
  currency     String       @default("VND")
  message      String       @default("")
  /// Q-G5c-1: gom theo người — `user_id` (giữ cột cho NĐT ngoài hệ thống)
  investorKey  String       @map("investor_key")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([investorKey, createdAt(sort: Desc)])
  @@map("investor_interests")
}

/**
 * Tổng hợp theo nhà đầu tư cho Admin (gom theo `investor_key`) — cập nhật cùng transaction với
 * `investor_interests` để danh sách Admin là Index Scan theo `last_at`, không GROUP BY toàn bảng.
 * Loại / đơn vị / SĐT = của lần quan tâm mới nhất.
 */
model InvestorSummary {
  investorKey     String       @id @map("investor_key")
  userId          String       @map("user_id")
  firstInterestId String       @map("first_interest_id")
  kind            InvestorKind
  organization    String       @default("")
  phone           String       @default("")
  totalAmount     BigInt       @default(0) @map("total_amount")
  interestCount   Int          @default(0) @map("interest_count")
  lastAt          DateTime     @map("last_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastAt(sort: Desc), investorKey])
  @@index([kind, lastAt(sort: Desc), investorKey])
  @@map("investor_summaries")
}
