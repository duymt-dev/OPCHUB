// Domain local-business — Gian hàng địa phương (V4-608, REQ-510, D-75, D-84, §25.1/25.2, §27.6 UP-08 / AD-07).
// Chỉ TK Doanh nghiệp đã đóng phí có gian hàng; tự tạo khi đóng phí (bản nháp), chủ xuất bản → hiện ngay.

enum StoreStatus {
  draft
  published
  hidden

  @@map("store_status")
}

/// §25.1: Sinh viên · Cá nhân · Tổ chức · Doanh nghiệp
enum StoreAudience {
  student
  personal
  organization
  business

  @@map("store_audience")
}

enum StoreItemKind {
  product
  service

  @@map("store_item_kind")
}

/// OQ-12: mỗi TK DN một gian hàng (UQ owner_id)
model Store {
  id           String        @id @default(uuid(7))
  ownerId      String        @unique @map("owner_id")
  name         String
  slogan       String        @default("")
  /// Danh mục scope `project` (tên); rỗng khi tự tạo
  field        String        @default("")
  province     String        @default("")
  audience     StoreAudience @default(business)
  coverUrl     String?       @map("cover_url")
  intro        String        @default("")
  website      String        @default("")
  phone        String        @default("")
  email        String        @default("")
  address      String        @default("")
  status       StoreStatus   @default(draft)
  /// Trạng thái trước khi Admin ẩn — hiện lại trả về đúng trạng thái này
  hiddenPrev   StoreStatus?  @map("hidden_prev")
  hiddenReason String?       @map("hidden_reason")
  hiddenBy     String?       @map("hidden_by")
  itemCount    Int           @default(0) @map("item_count")
  /// Nhóm loại item để lọc "Sản phẩm & dịch vụ" không cần join (cập nhật cùng transaction)
  hasProduct   Boolean       @default(false) @map("has_product")
  hasService   Boolean       @default(false) @map("has_service")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items StoreItem[]
  needs Need[]

  @@index([status, province, field, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc), id])
  /// Bảng Admin (AD-07, D-89): thứ tự tạo
  @@index([status, createdAt, id])
  @@index([createdAt, id])
  @@map("stores")
}

model StoreItem {
  id          String        @id @default(uuid(7))
  storeId     String        @map("store_id")
  kind        StoreItemKind
  name        String
  /// VND số nguyên; NULL = "Liên hệ báo giá"
  price       Int?
  description String        @default("")
  imageUrl    String?       @map("image_url")
  sort        Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, sort])
  @@map("store_items")
}

// ── V4-609 Nhu cầu địa phương (REQ-511, UP-09, AD-07) — chủ gian hàng đăng, hiện ngay, Admin chỉ ẩn ──

/// Prototype NT: Cần mua · Cần đầu ra · Cần đối tác · Cần dịch vụ · Cần giải pháp · Cần nhân sự ·
/// Cần mặt bằng / kho · Cần vốn · Nhu cầu khác
enum NeedType {
  buy
  sell
  partner
  service
  solution
  staff
  space
  capital
  other

  @@map("need_type")
}

enum NeedStatus {
  open
  closed
  hidden

  @@map("need_status")
}

/// Phạm vi tìm đối tác: Trong tỉnh / Trong vùng, lân cận / Toàn quốc
enum NeedScope {
  province
  region
  nation

  @@map("need_scope")
}

enum NeedChannel {
  zalo
  call
  email

  @@map("need_channel")
}

model Need {
  id           String      @id @default(uuid(7))
  storeId      String      @map("store_id")
  ownerId      String      @map("owner_id")
  type         NeedType
  title        String
  description  String
  /// Danh mục scope `project`, hoặc chữ tự nhập khi chọn "Khác" (`field_custom`)
  field        String
  fieldCustom  Boolean     @default(false) @map("field_custom")
  quantity     String      @default("")
  /// VND số nguyên; cả hai NULL = "Thỏa thuận"
  budgetMin    BigInt?     @map("budget_min")
  budgetMax    BigInt?     @map("budget_max")
  province     String
  ward         String      @default("")
  dueAt        DateTime?   @map("due_at") @db.Timestamptz(6)
  scope        NeedScope   @default(province)
  cooperation  String[]    @default([])
  standards    String[]    @default([])
  docUrl       String      @default("") @map("doc_url")
  contactName  String      @default("") @map("contact_name")
  phone        String      @default("")
  email        String      @default("")
  channel      NeedChannel @default(zalo)
  status       NeedStatus  @default(open)
  /// Trạng thái trước khi Admin ẩn — hiện lại trả về đúng trạng thái này
  hiddenPrev   NeedStatus? @map("hidden_prev")
  hiddenReason String?     @map("hidden_reason")
  hiddenBy     String?     @map("hidden_by")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt(sort: Desc), id])
  @@index([status, province, field, updatedAt(sort: Desc)])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([storeId, status])
  @@map("needs")
}
