// Domain local-business — Gian hàng địa phương (V4-608, REQ-510, D-75, D-84, §25.1/25.2, §27.6 UP-08 / AD-07).
// Chỉ TK Doanh nghiệp đã đóng phí có gian hàng; tự tạo khi đóng phí (bản nháp), chủ xuất bản → hiện ngay.

enum StoreStatus {
  draft
  published
  hidden

  @@map("store_status")
}

/// §25.1: Sinh viên · Cá nhân · Tổ chức · Doanh nghiệp
enum StoreAudience {
  student
  personal
  organization
  business

  @@map("store_audience")
}

enum StoreItemKind {
  product
  service

  @@map("store_item_kind")
}

/// OQ-12: mỗi TK DN một gian hàng (UQ owner_id)
model Store {
  id           String        @id @default(uuid(7))
  ownerId      String        @unique @map("owner_id")
  name         String
  slogan       String        @default("")
  /// Danh mục scope `project` (tên); rỗng khi tự tạo
  field        String        @default("")
  province     String        @default("")
  audience     StoreAudience @default(business)
  /// D-89 (P-105): loại hình (Doanh nghiệp / Hợp tác xã / Hộ kinh doanh / OPC / Cá nhân) — tag thứ 2
  /// trên thẻ Khám phá như prototype; rỗng khi chưa có (form v4 không có ô này)
  legalForm    String        @default("") @map("legal_form")
  coverUrl     String?       @map("cover_url")
  intro        String        @default("")
  website      String        @default("")
  phone        String        @default("")
  email        String        @default("")
  address      String        @default("")
  status       StoreStatus   @default(draft)
  /// Trạng thái trước khi Admin ẩn — hiện lại trả về đúng trạng thái này
  hiddenPrev   StoreStatus?  @map("hidden_prev")
  hiddenReason String?       @map("hidden_reason")
  hiddenBy     String?       @map("hidden_by")
  itemCount    Int           @default(0) @map("item_count")
  /// D-89 (P-105): lượt xem trang chi tiết (người khác chủ), tăng khi mở chi tiết như dự án
  viewCount    Int           @default(0) @map("view_count")
  /// D-89: Admin gắn "Nổi bật" (nhiều gian hàng được — prototype có 3); null = không
  featuredAt   DateTime?     @map("featured_at") @db.Timestamptz(6)
  /// Nhóm loại item để lọc "Sản phẩm & dịch vụ" không cần join (cập nhật cùng transaction)
  hasProduct   Boolean       @default(false) @map("has_product")
  hasService   Boolean       @default(false) @map("has_service")
  /// TIP-V42-710 (D-97): phường / xã — "{phường}, {tỉnh}" trên chi tiết + xem trước
  ward         String        @default("")
  /// Logo đang chọn (một trong `logos`); null = chữ viết tắt
  logoUrl      String?       @map("logo_url")
  logos        String[]      @default([])
  /// Ảnh bìa tự tải lên (ảnh mẫu prototype `COVERS` không lưu ở đây)
  covers       String[]      @default([])
  /// Ảnh mẫu chủ đã bấm × (prototype `hidCovers`)
  hiddenCovers String[]      @default([]) @map("hidden_covers")
  vision       String        @default("")
  mission      String        @default("")
  gallery      String[]      @default([])
  /// `storeVideoSchema[]` (url, title)
  videos       Json          @default("[]")
  /// `storeTeamSchema[]` (name, role, desc, photoUrl)
  team         Json          @default("[]")
  /// `storeCertSchema[]` (name, org, imageUrl)
  certs        Json          @default("[]")
  /// `storeDocSchema[]` (name, ext, size, bytes, url)
  docs         Json          @default("[]")
  /// Hotline / email / địa chỉ thêm ngoài `phone` / `email` / `address`
  phones       String[]      @default([])
  emails       String[]      @default([])
  addresses    String[]      @default([])
  /// `{ zalo, fb, yt, tt, li }` — website ở cột `website`
  socials      Json          @default("{}")
  /// Mọi URL object storage của gian hàng — GC media hỏi bằng `&&` (GIN)
  mediaUrls    String[]      @default([]) @map("media_urls")
  /// Tạo tự động (đăng ký / đóng phí / migration D-114) — Portal mở thẳng trình tạo khi còn trống
  autoCreated  Boolean       @default(false) @map("auto_created")
  publishedAt  DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items StoreItem[]
  needs Need[]
  favs  StoreFavorite[]
  views StoreDailyView[]

  @@index([status, province, field, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc), id])
  /// Bảng Admin (AD-07, D-89): thứ tự tạo
  @@index([status, createdAt, id])
  @@index([createdAt, id])
  @@index([mediaUrls], type: Gin)
  @@map("stores")
}

/// D-114 S6: lượt xem chi tiết theo ngày (Asia/Ho_Chi_Minh) — dashboard "Hiệu suất gian hàng · 7 ngày qua"
model StoreDailyView {
  storeId String   @map("store_id")
  day     DateTime @db.Date
  views   Int      @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, day])
  @@map("store_daily_views")
}

/// D-89 (P-105): tim "Yêu thích" trên thẻ Khám phá — mỗi người một dòng / gian hàng
model StoreFavorite {
  storeId   String   @map("store_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Tra "tôi đã thích những gian hàng nào trong trang này": (user_id, store_id) bằng nhau cả hai
  @@id([userId, storeId])
  @@index([storeId])
  @@map("store_favorites")
}

model StoreItem {
  id          String        @id @default(uuid(7))
  storeId     String        @map("store_id")
  kind        StoreItemKind
  name        String
  /// VND số nguyên; NULL = "Liên hệ báo giá"
  price       Int?
  description String        @default("")
  imageUrl    String?       @map("image_url")
  sort        Int           @default(0)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, sort])
  @@map("store_items")
}

// ── V4-609 Nhu cầu địa phương (REQ-511, UP-09, AD-07) — chủ gian hàng đăng, hiện ngay, Admin chỉ ẩn ──

/// Prototype NT: Cần mua · Cần đầu ra · Cần đối tác · Cần dịch vụ · Cần giải pháp · Cần nhân sự ·
/// Cần mặt bằng / kho · Cần vốn · Nhu cầu khác
enum NeedType {
  buy
  sell
  partner
  service
  solution
  staff
  space
  capital
  other

  @@map("need_type")
}

enum NeedStatus {
  open
  closed
  hidden

  @@map("need_status")
}

/// Phạm vi tìm đối tác: Trong tỉnh / Trong vùng, lân cận / Toàn quốc
enum NeedScope {
  province
  region
  nation

  @@map("need_scope")
}

enum NeedChannel {
  zalo
  call
  email

  @@map("need_channel")
}

model Need {
  id           String      @id @default(uuid(7))
  storeId      String      @map("store_id")
  ownerId      String      @map("owner_id")
  type         NeedType
  title        String
  description  String
  /// Danh mục scope `project`, hoặc chữ tự nhập khi chọn "Khác" (`field_custom`)
  field        String
  fieldCustom  Boolean     @default(false) @map("field_custom")
  quantity     String      @default("")
  /// VND số nguyên; cả hai NULL = "Thỏa thuận"
  budgetMin    BigInt?     @map("budget_min")
  budgetMax    BigInt?     @map("budget_max")
  province     String
  ward         String      @default("")
  dueAt        DateTime?   @map("due_at") @db.Timestamptz(6)
  scope        NeedScope   @default(province)
  cooperation  String[]    @default([])
  standards    String[]    @default([])
  docUrl       String      @default("") @map("doc_url")
  contactName  String      @default("") @map("contact_name")
  phone        String      @default("")
  email        String      @default("")
  channel      NeedChannel @default(zalo)
  status       NeedStatus  @default(open)
  /// Trạng thái trước khi Admin ẩn — hiện lại trả về đúng trạng thái này
  hiddenPrev   NeedStatus? @map("hidden_prev")
  hiddenReason String?     @map("hidden_reason")
  hiddenBy     String?     @map("hidden_by")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  owner User  @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt(sort: Desc), id])
  @@index([status, province, field, updatedAt(sort: Desc)])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([storeId, status])
  @@map("needs")
}
