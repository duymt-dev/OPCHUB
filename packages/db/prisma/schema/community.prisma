// Domain community — data-model §3. Bảng rooms tối thiểu (seed phòng general); B23 thêm messages.

enum Region {
  north
  central
  south

  @@map("region")
}

/// D-89 (prototype v4): nhóm tỉnh (34) + nhóm ngành con của nhóm tỉnh (56)
enum GroupKind {
  province
  industry

  @@map("group_kind")
}

enum GroupRole {
  owner
  lecturer
  member

  @@map("group_role")
}

/// D-71: bỏ duyệt vào nhóm → không còn pending / rejected / cancelled
enum GroupMemberStatus {
  member
  left
  removed

  @@map("group_member_status")
}

model Group {
  id           String        @id @default(uuid(7))
  /// UQ partial `WHERE deleted_at IS NULL` viết tay (xoá mềm rồi tạo lại được)
  slug         String
  /// Mỗi tỉnh một nhóm tỉnh (Q-G4c-6) — UQ partial `WHERE kind = 'province' AND deleted_at IS NULL`
  province     String
  region       Region
  /// D-89: nhóm tỉnh / nhóm ngành; nhóm ngành có `industry` + `parent_id` (nhóm tỉnh cha)
  kind         GroupKind     @default(province)
  industry     String?
  parentId     String?       @map("parent_id")
  name         String
  description  String        @default("")
  coverUrl     String?       @map("cover_url")
  rules        String[]      @default([])
  /// Cập nhật trong cùng transaction với group_members
  memberCount  Int           @default(0) @map("member_count")
  /// Thành viên gửi tin trong 7 ngày, scheduler cập nhật (S-10)
  weeklyActive Int           @default(0) @map("weekly_active")
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  members       GroupMember[]
  rooms         Room[]
  events        Event[]
  projects      Project[]
  projectShares ProjectShare[]
  botRotationCursor BotRotationCursor?

  @@index([region, memberCount(sort: Desc)])
  @@map("groups")
}

model GroupMember {
  groupId   String            @map("group_id")
  userId    String            @map("user_id")
  groupRole GroupRole         @default(member) @map("group_role")
  status    GroupMemberStatus @default(member)
  intro     String?
  decidedBy String?           @map("decided_by")
  decidedAt DateTime?         @map("decided_at") @db.Timestamptz(6)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Báo cáo B1/B2/B3 (V4-614): partial `(group_id, created_at) INCLUDE (user_id) WHERE status = 'member'` viết tay
  /// D-121: partial `(user_id, created_at, group_id) WHERE status = 'member'` for earliest province seek.
  @@id([groupId, userId])
  @@index([userId, status])
  @@index([groupId, status, groupRole])
  @@map("group_members")
}

model Room {
  id          String   @id @default(uuid(7))
  groupId     String   @map("group_id")
  slug        String
  name        String
  description String   @default("")
  createdBy   String?  @map("created_by")
  isDefault   Boolean  @default(false) @map("is_default")
  /// D-111: Admin xoá mềm chủ đề — tin giữ, phòng ẩn khỏi Portal; CHECK "Chung" không xoá (viết tay)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy   String?   @map("deleted_by")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  messages    Message[]
  pins        PinnedMessage[]
  readCursors RoomReadCursor[]

  @@unique([groupId, slug])
  @@map("rooms")
}
