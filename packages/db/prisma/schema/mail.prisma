// Domain mail — data-model §11. Thư gửi qua worker `mail`; `body_html` xoá sau khi gửi (OTP/link không nằm lâu trong DB).

enum MailKind {
  otp
  welcome
  password_reset
  fee_reminder
  event
  campaign
  test
  /// NA-22: xác nhận phiếu yêu cầu dịch vụ
  service
  /// V4-610: nhắc gia hạn / hết hạn Gói Gọi vốn
  fundraising
  fundraising_expired
  /// V4-611 (D-88): Admin nhắc hoàn tất hướng dẫn bắt đầu
  onboarding
  /// V42-704 (D-113 F4): biên nhận thanh toán phí thành viên / Gói Gọi vốn
  receipt
  regional_director
  regional_director_appoint
  regional_director_revoke

  @@map("mail_kind")
}

enum MailStatus {
  queued
  sent
  failed
  /// BUG-036: chiến dịch bị dừng — thư chưa gửi chuyển sang đây, giữ lại để đối chiếu
  cancelled

  @@map("mail_status")
}

model MailLog {
  id                String     @id @default(uuid(7))
  to                String     @db.Citext
  kind              MailKind
  subject           String
  /// Nội dung đã dựng; NULL sau khi gửi xong
  bodyHtml          String?    @map("body_html")
  status            MailStatus @default(queued)
  attempts          Int        @default(0)
  providerMessageId String?    @map("provider_message_id")
  error             String?
  campaignId        String?    @map("campaign_id")
  /// NA-05: 1 = OTP/đặt lại MK, 3 = giao dịch, 4 = thử, 5 = chiến dịch (số nhỏ chạy trước)
  priority          Int        @default(5) @db.SmallInt
  /// Lần thử kế tiếp (backoff 1/5/15 phút, hoặc dời qua hạn mức ngày)
  nextAttemptAt     DateTime?  @map("next_attempt_at") @db.Timestamptz(6)
  sentAt            DateTime?  @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([kind, createdAt(sort: Desc)])
  @@index([campaignId])
  @@index([to, createdAt(sort: Desc)])
  @@map("mail_logs")
}
