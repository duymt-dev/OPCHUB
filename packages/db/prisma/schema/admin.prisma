// Domain admin-account — SRS-3.6 §21.5 (D-52): tài khoản quản trị tách khỏi `users` thành viên.

enum AdminUserStatus {
  active
  locked

  @@map("admin_user_status")
}

/// RB-R04: 5 vai trò hệ thống (`key` cố định, `is_system`) + vai trò tự tạo (`key` NULL)
model AdminRole {
  id          String   @id @default(uuid(7))
  key         String?  @unique
  name        String   @unique @db.Citext
  description String   @default("")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions AdminRolePermission[]
  users       AdminUser[]

  @@map("admin_roles")
}

/// RB-R05: ma trận vai trò × 25 khoá quyền. Super Admin không lưu dòng (luôn đủ quyền)
model AdminRolePermission {
  roleId        String @map("role_id")
  permissionKey String @map("permission_key")

  role AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("admin_role_permissions")
}

/**
 * TK quản trị (RB-R02). `id` giữ nguyên id cũ ở `users` khi chuyển dữ liệu (audit_logs.actor_id…).
 * `role_id` chỉ NULL khi đã xoá mềm: CHECK `admin_users_role_or_deleted` viết tay.
 * Index `admin_users_role_live (role_id) WHERE deleted_at IS NULL` viết tay.
 */
model AdminUser {
  id            String          @id @default(uuid(7))
  name          String
  email         String          @unique @db.Citext
  phone         String?
  roleId        String?         @map("role_id")
  passwordHash  String          @map("password_hash")
  mustChangePwd Boolean         @default(true) @map("must_change_pwd")
  totpSecretEnc Bytes?          @map("totp_secret_enc")
  status        AdminUserStatus @default(active)
  permVersion   Int             @default(1) @map("perm_version")
  lastLoginAt   DateTime?       @map("last_login_at") @db.Timestamptz(6)
  createdBy     String?         @map("created_by")
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  role          AdminRole?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  refreshTokens AdminRefreshToken[]

  @@map("admin_users")
}

/// Refresh token phiên Admin (TIP-V2-202) — cùng cấu trúc `refresh_tokens`
model AdminRefreshToken {
  id          String    @id @default(uuid(7))
  adminUserId String    @map("admin_user_id")
  familyId    String    @map("family_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy  String?   @map("replaced_by")
  userAgent   String?   @map("user_agent")
  ip          String?   @db.Inet
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("admin_refresh_tokens")
}
