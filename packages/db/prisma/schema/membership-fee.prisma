// Domain membership-fee — data-model §2. Tiền là Int (VND), không Float/Decimal.

enum MembershipFeeStatus {
  pending_payment
  active
  expiring
  expired

  @@map("membership_fee_status")
}

/// D-68: gói thành viên theo loại TK lúc đăng ký (giá ở `packages/shared/src/membership/plans.ts`)
enum MembershipPlan {
  personal
  business

  @@map("membership_plan")
}

enum FeePeriodSource {
  transfer
  manual

  @@map("fee_period_source")
}

enum PaymentMatchStatus {
  unmatched
  matched
  manual
  ignored

  @@map("payment_match_status")
}

/// Bản ghi phí hiện hành, 1–1 users
model MembershipFee {
  userId     String              @id @map("user_id")
  status     MembershipFeeStatus @default(pending_payment)
  validUntil DateTime?           @map("valid_until") @db.Timestamptz(6)
  /// Số phải trả ở lần thanh toán kế tiếp (D-68/D-69) — ghi tường minh, không default
  amount     Int
  plan       MembershipPlan      @default(personal)
  paidAt     DateTime?           @map("paid_at") @db.Timestamptz(6)
  /// Tăng mỗi lần đổi, dùng cho cache JWT/Redis (S-03)
  version    Int                 @default(1)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Admin Phí lọc theo tab; partial membership_fees_due, membership_fees_paid_at viết tay trong migration
  @@index([status, updatedAt(sort: Desc)])
  @@map("membership_fees")
}

/// Báo cáo tháng (V4-614): `(created_at) INCLUDE (user_id, amount)` viết tay trong migration
model MembershipFeePeriod {
  id                   String          @id @default(uuid(7))
  userId               String          @map("user_id")
  startsAt             DateTime        @map("starts_at") @db.Timestamptz(6)
  endsAt               DateTime        @map("ends_at") @db.Timestamptz(6)
  amount               Int
  source               FeePeriodSource
  paymentTransactionId String?         @unique @map("payment_transaction_id")
  collectedBy          String?         @map("collected_by")
  /// Bắt buộc khi source = manual (D-41), CHECK trong migration
  reason               String?
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentTransaction PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])
  commission         Commission?

  @@index([userId, endsAt(sort: Desc)])
  @@map("membership_fee_periods")
}

model PaymentTransaction {
  id            String             @id @default(uuid(7))
  provider      String
  bankTxnId     String             @map("bank_txn_id")
  amount        Int
  content       String
  receivedAt    DateTime           @map("received_at") @db.Timestamptz(6)
  matchStatus   PaymentMatchStatus @default(unmatched) @map("match_status")
  matchedUserId String?            @map("matched_user_id")
  matchedAt     DateTime?          @map("matched_at") @db.Timestamptz(6)
  raw           Json
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  period      MembershipFeePeriod?
  fundraising ProjectFundraising?

  /// Webhook + poll trùng thì ON CONFLICT DO NOTHING
  @@unique([provider, bankTxnId])
  @@index([matchedUserId, receivedAt(sort: Desc)])
  @@map("payment_transactions")
}

/// Nhắc phí tự động đã gửi (NA-04, D-57): mỗi mốc ≤ 1 lần cho mỗi kỳ (`valid_until`).
/// Gia hạn đổi `valid_until` → kỳ mới được nhắc lại. CHECK milestone + partial index viết tay.
model FeeReminder {
  userId     String   @map("user_id")
  validUntil DateTime @map("valid_until") @db.Timestamptz(6)
  milestone  String
  sentAt     DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, validUntil, milestone])
  @@map("fee_reminders")
}
