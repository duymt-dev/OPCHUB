// Domain settings — data-model §10.

model Category {
  id        String    @id @default(uuid(7))
  name      String    @unique @db.Citext
  color     String
  /// project | biz
  scopes    String[]
  sort      Int       @default(0)
  /// BR-11: đang dùng thì chỉ ẩn, không xoá
  hidden    Boolean   @default(false)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  projects Project[]

  @@index([sort])
  @@map("categories")
}

/// general, security, languages, welcome_mail (D-47), bot…
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

/// Singleton encrypted webhook credential; plaintext returned only at rotation.
model BankWebhookKey {
  id        Int      @id @default(1)
  keyEnc    Bytes    @map("key_enc")
  hint      String
  rotatedBy String?  @map("rotated_by")
  rotatedAt DateTime @default(now()) @map("rotated_at") @db.Timestamptz(6)

  @@map("bank_webhook_keys")
}

/// Một dòng; key mã hoá AES-256-GCM, không bao giờ trả ra ngoài
model SmtpConfig {
  id         Int      @id @default(1)
  host       String
  port       Int
  encryption String
  username   String
  keyEnc     Bytes?   @map("key_enc")
  fromName   String   @map("from_name")
  fromEmail  String   @map("from_email")
  replyTo    String   @map("reply_to")
  dailyLimit Int      @map("daily_limit")
  enabled    Boolean  @default(true)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("smtp_configs")
}

model AdminInvite {
  id         String     @id @default(uuid(7))
  email      String     @db.Citext
  systemRole SystemRole @map("system_role")
  tokenHash  String     @unique @map("token_hash")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime?  @map("accepted_at") @db.Timestamptz(6)
  revokedAt  DateTime?  @map("revoked_at") @db.Timestamptz(6)
  invitedBy  String     @map("invited_by")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@map("admin_invites")
}
