# Đọc qua src/lib/env.ts (zod)
NEXT_PUBLIC_API_URL=/v1
# msw = dùng mock (chưa có backend) | off = gọi API thật
NEXT_PUBLIC_API_MOCKING=msw
# D-35 + V2Q-163: on | off — hộp tài khoản dùng thử trên màn đăng nhập (mặc định off như prototype ver2)
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=
# D-05: on | off — Bot tương tác (feature flag); trống = bật khi dùng MSW
NEXT_PUBLIC_FEATURE_BOTS=
# Gốc User Portal cho link chia sẻ (trống = https://opchub.community)
NEXT_PUBLIC_PORTAL_URL=
# MSW bridge requires the actual same-host Portal origin, e.g. http://localhost:3000.
# Configure this before building Admin; native mode does not load the relay.
# Dev/e2e với server thật: Next chuyển tiếp /v1/* tới đây (production dùng Nginx)
API_PROXY_URL=

# Optional isolated Next build output; unset defaults to .next.
# Use .next-msw-v2 / .next-server for separate test targets.
# NEXT_DIST_DIR=.next
