# apps/server — chép thành .env (gitignored). Không ghi secret vào file này.
NODE_ENV=development
API_PORT=4000
SOCKET_PORT=4001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Chỉ dev/e2e/k6 một máy: true tắt rate limit (server từ chối ở production)
RATE_LIMIT_DISABLED=
# TD-018: handshake socket tối đa / phút / IP và / tài khoản (mặc định 30)
SOCKET_CONNECT_PER_MIN=30
TRUST_PROXY=false
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379
REDIS_DB=1
DB_POOL_MAX=10
# ≥ 32 ký tự ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=opchub
REFRESH_COOKIE_SECURE=false
PORTAL_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
MAIL_PROVIDER=fake
# Chỉ dev/e2e (TD-035): FakeMail ghi thư ra thư mục để e2e đọc link (cấm ở production)
# e2e server: FAKE_MAIL_DIR=D:/opchub-local/mailbox
FAKE_MAIL_DIR=
# D-05: Bot / Dịch vụ (GĐ3) — production mặc định false; dev/test bật để e2e Admin chạy
FEATURE_BOTS=true
FEATURE_SERVICES=true
MAIL_FROM_NAME=OPC Hub
MAIL_FROM_EMAIL=no-reply@opchub.community
# NA-05: thư/ngày dành riêng cho OTP + đặt lại mật khẩu trong hạn mức SMTP (mặc định 20)
MAIL_OTP_RESERVE=
# BUG-036: HMAC link huỷ nhận thư chiến dịch (≥ 32 ký tự; dev trống → suy từ JWT_SECRET)
UNSUBSCRIBE_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
BANK_PROVIDER=fake
# ≥ 16 ký tự ngẫu nhiên
BANK_WEBHOOK_SECRET=
SEPAY_API_TOKEN=
BANK_ACCOUNT_NO=
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_FULL_NAME=
# D-65: fake (dev/test) | chain = DLPL → ESGOO → VietQR (production) | dlpl = chỉ DLPL (e2e với stub)
TAX_LOOKUP_PROVIDER=fake
# D-65: key DLPL API gói Starter+ (api.dulieuphapluat.vn) — chỉ gửi qua header, không commit
DLPL_API_KEY=
DLPL_BASE_URL=
# D-64: fake chỉ dev/test (cấm ở production); google = OIDC thật
SSO_PROVIDER=fake
# Google Console › Authorized redirect URI: <PORTAL_URL>/sso/callback/google (một URI cho cả 4 nút)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# s3 (mặc định) | local (chỉ dev/e2e: lưu đĩa, phục vụ qua /v1/uploads/*)
STORAGE_PROVIDER=
# Bắt buộc khi STORAGE_PROVIDER=local — thư mục ngoài repo
LOCAL_STORAGE_DIR=
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=opchub-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
# 32 byte base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENC_KEY=

# Chỉ dev/test: OTP cố định cho e2e (cấm ở production)
OTP_FIXED_CODE=

# Integration tests only: local native Postgres test database, never dev/prod.
# Replace placeholder credentials locally; do not commit a real connection URL.
# TEST_DATABASE_URL=postgresql://opchub:CHANGE_ME@127.0.0.1:5432/opchub_test
# TEST_LOG_LEVEL=silent
