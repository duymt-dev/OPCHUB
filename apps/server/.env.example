# apps/server — chép thành .env (gitignored). Không ghi secret vào file này.
NODE_ENV=development
API_PORT=4000
SOCKET_PORT=4001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379
REDIS_DB=1
DB_POOL_MAX=10
# ≥ 32 ký tự ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=opchub
REFRESH_COOKIE_SECURE=false
